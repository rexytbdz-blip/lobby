{
  "name": "messenger-desktop",
  "version": "1.1.0",
  "description": "App de bureau Electron - salons texte/vocal proteges par mot de passe",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "socket.io-client": "^4.7.5",
    "simple-peer": "^9.11.1"
  },
  "devDependencies": {
